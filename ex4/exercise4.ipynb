    "    results1[deg] = {'theta': theta, 'Log_L': log_L}\n",
    "    #print(results1[deg]['theta'])\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 29,
   "id": "75e85a7a-41eb-4aed-a4ca-b3211ec1a5d2",
   "metadata": {},
   "outputs": [],
   "source": [
