   "id": "d0ede197-5c73-4f39-a312-859710d7e5f1",
   "metadata": {},
   "outputs": [],
   "source": [
    "def polynomial_reg(deg, logR, logM, sigma):\n",
    "    '''\n",
    "    Uses numpy's polyfit with weighting (smaller uncertainties have more influence)\n",
    "    Args:\n",
    "    deg (int): Degree of the polynomial to fit\n",
    "    logR (array):log10 of planet radii\n",
    "    logM (array): log10 of planet masses\n",
    "    sigma (array): error on logM (used for weights)\n",
    "\n",
    "    Returns\n",
    "    coeffs (array): coefficients (ex. ax^2 + bx +c, returns: [a,b,c])   \n",
    "    '''\n",
    "    w = 1.0 / sigma\n",
    "    coeffs = np.polyfit(logR, logM, deg=deg, w=w)\n",
    "    return coeffs"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 113,
   "id": "102cf19a-f199-469b-b8e4-b6bfbd066a09",
   "metadata": {},
   "outputs": [],
   "source": [
    "def poly_mle(deg, logR, logM, sigma):\n",
    "    '''\n",
    "    Uses maximum likelihood estimation (MLE) with uncertainty weighting to find polynomial fits\n",
    "    Args:\n",
    "    deg (int): Degree of the polynomial to fit\n",
    "    logR (array):log10 of planet radii\n",
    "    logM (array): log10 of planet masses\n",
    "    sigma (array): error on logM (used for precision matrix)\n",
    "\n",
    "    Returns\n",
    "    theta (array): matrix containing coefficients (ex. ax^2 + bx +c, returns: [c,b,a])\n",
    "    \n",
    "    '''\n",
    "    X = np.column_stack([logR**k for k in range(deg + 1)]) \n",
    "    C = 1.0 / sigma**2\n",
    "    XtC = X.T * C\n",
    "    theta = np.linalg.solve(XtC @ X, XtC @ logM)\n",
    "\n",
    "    residuals = logM - X @ theta\n",
    "    chi2 = np.sum((residuals / sigma)**2)/len(logR)\n",
    "    log_L = 0.5 * chi2\n",
    "    return theta, log_L, chi2"
   ]
  },
