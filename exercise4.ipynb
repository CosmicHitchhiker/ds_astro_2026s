    "#apply log transform on sample a\n",
    "logMa = np.log10(sample_a['pl_bmasse']).values\n",
    "logRa = np.log10(sample_a['pl_rade']).values\n",
    "sigma_logMa = sample_a['pl_mass_err'].values/(sample_a['pl_bmasse'].values * np.log(10))\n"
