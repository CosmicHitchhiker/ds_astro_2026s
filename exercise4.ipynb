   "source": [
    "def log_errs(val, errs):\n",
    "    upper = np.log10(val+errs)\n",
    "    mask = (val - errs <= 0)\n",
    "    lower = np.log10(val-errs)\n",
    "    lower[mask] = -np.inf\n",
    "    logerr = 0.5*(upper-lower)\n",
    "    return logerr"
   ]
